
<Window x:Class="TelecomLocator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Title="Telecom Prefix Locator" Height="450" Width="600">
    <StackPanel Margin="20">
        <Label Content="Search Prefix or Country:" FontWeight="Bold"/>
        
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                 FontSize="16" Margin="0,5,0,20"/>

        <DataGrid ItemsSource="{Binding Results}" 
                  AutoGenerateColumns="False" IsReadOnly="True" Height="300">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Prefix" Binding="{Binding Prefix}" Width="80"/>
                <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="*"/>
                <DataGridTextColumn Header="Region/Type" Binding="{Binding Region}" Width="120"/>
                <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</Window>
